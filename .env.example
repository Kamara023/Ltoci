# ============================================================
# LotoStats CI — variables d'environnement (modèle)
# Copier vers .env et adapter. NE JAMAIS commiter .env.
# ============================================================

# --- PostgreSQL (conteneur docker-compose.dev.yml) ---
POSTGRES_USER=lotostats
POSTGRES_PASSWORD=lotostats_dev
POSTGRES_DB=lotostats
# NB : le compose dev publie PostgreSQL sur 5433 et Redis sur 6380 (les ports
# standard peuvent être occupés par des services locaux).
DATABASE_URL=postgresql://lotostats:lotostats_dev@localhost:5433/lotostats

# --- Redis ---
REDIS_URL=redis://localhost:6380

# --- API NestJS ---
API_PORT=3001
# Secrets JWT (utilisés à partir de la PHASE 5 — déjà réservés)
JWT_ACCESS_SECRET=dev-access-secret-a-changer
JWT_REFRESH_SECRET=dev-refresh-secret-a-changer

# --- Service ML FastAPI ---
ML_PORT=8000
ML_SERVICE_URL=http://localhost:8000
# Token partagé API <-> ML (réseau interne uniquement)
ML_SERVICE_TOKEN=dev-ml-token-a-changer

# --- Seed (compte SUPERADMIN créé par prisma db seed) ---
SEED_ADMIN_EMAIL=admin@lotostats.local
SEED_ADMIN_PASSWORD=ChangeMoi!2026
